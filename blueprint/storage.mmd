flowchart LR
  open[openProject<br/>the tab's terminal folder]
  checkout[checkoutOf<br/>git rev-parse --show-toplevel]
  ddir[diagramDir<br/>checkout/blueprint]
  sdir[stateDir<br/>app folder, per project]
  look[lookForFolder<br/>every 3 s until the agent makes it]
  watch[watch<br/>watchFolder on blueprint/]
  poll[poll<br/>every 5 s]
  load[load<br/>*.mmd and when each changed]
  meta[project.json<br/>agent · asked · file times]
  prune[pruneAll<br/>records of gone projects]

  open --> checkout
  checkout --> ddir
  checkout --> sdir
  ddir --> look
  look --> watch
  watch --> load
  poll --> load
  poll -->|rereadMeta| meta
  load -->|updateMeta| meta
  sdir --> meta
  prune --> meta

